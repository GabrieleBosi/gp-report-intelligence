{
  "name": "gp-report-intelligence",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run --coverage",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:watch": "vitest",
    "corpus:generate": "node corpus/generate.ts",
    "corpus:verify": "node corpus/verify.ts",
    "corpus:seed": "node corpus/seed.ts",
    "corpus:scan": "node corpus/scan.ts",
    "test:e2e": "playwright test",
    "test:e2e:snapshot": "playwright test -c playwright.snapshot.config.ts",
    "eval:harvest": "node scripts/eval-harvest.ts",
    "eval": "node scripts/eval.ts",
    "eval:heldout": "node scripts/eval.ts --heldout",
    "eval:shadow": "node scripts/eval-shadow.ts",
    "eval:live": "node scripts/acceptance.ts",
    "eval:candidate": "node scripts/eval-candidate.ts",
    "media:review-gif": "node scripts/record-review-gif.ts",
    "showcase:facts": "node scripts/showcase-facts.ts",
    "snapshot": "node scripts/snapshot.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@napi-rs/canvas": "^1.0.11",
    "@supabase/supabase-js": "^2.117.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^6.0.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pdfkit": "^0.20.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "tesseract.js": false
  }
}
